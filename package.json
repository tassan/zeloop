{
  "name": "zeloop-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "zeloop monorepo: core worker, Postgres adapter, and outbox dispatcher.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint packages",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testcontainers/postgresql": "^11.11.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "pg": "^8.18.0",
    "prettier": "^3.2.0",
    "testcontainers": "^11.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "overrides": {}
  }
}
